{
  "expo": {
    "name": "Walkito",
    "slug": "tread",
    "scheme": "walkito",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer-skadnetwork.com/"
      },
      "bundleIdentifier": "com.walkito.app",
      "appleTeamId": "JDZGGZQJ7T",
      "associatedDomains": ["applinks:walkito.site", "applinks:walkito.onelink.me"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.walkito.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "walkito.onelink.me", "pathPrefix": "/2L97" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "./plugins/with-strip-frameworks",
      "./plugins/with-appsflyer-scene",
      "expo-router",
      "expo-asset",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/with-widget-locales",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DailyCheck",
              "displayName": "Walkito",
              "description": "Log today’s check-in and see your goal for the day.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": true,
          "NSHealthShareUsageDescription": "walkito reads your steps, walking pattern and sleep so your plan starts from what you have actually been doing.",
          "NSHealthUpdateUsageDescription": "walkito saves your sessions to Health so they count toward your activity."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "walkito counts the hours you spend on your feet, so it can remind you to give them a minute after a long stretch."
        }
      ],
      "expo-background-task",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "walkito uses this to learn which ads bring people to the app. Your health data is never shared."
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "talk",
              "title": "SOMETHING OFF?",
              "subtitle": "Tell us. A person replies.",
              "icon": "symbol:bubble.left"
            }
          ]
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect-delegate",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyCheck",
              "label": "Walkito",
              "description": "Log today’s check-in and see your goal for the day.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-hermes-sourcemap",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ru",
            "es",
            "pt",
            "fr",
            "de",
            "it"
          ]
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.walkito.app.dev.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.walkito.app.dev"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ada5351e-5344-43d9-a088-b23f1695cbb1"
      }
    },
    "owner": "nazarly-digital",
    "updates": {
      "url": "https://u.expo.dev/ada5351e-5344-43d9-a088-b23f1695cbb1"
    },
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json"
    }
  }
}
