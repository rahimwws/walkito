APP_VARIANT=development # LOCAL ONLY

# Supabase, for invite codes. The publishable (anon) key is public by design:
# every write goes through a `security definer` function, never a table policy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat. The PUBLIC SDK key — the dashboard lists these under "SDK API
# keys", separately from "Secret API keys". Apple's own key starts `appl_` and
# only exists once an App has been added to the project; a `test_` key is the
# Test Store, which needs no App Store Connect setup at all.
#
# NOT a secret key (`sk_…`). Those can grant entitlements and delete
# subscribers, and EXPO_PUBLIC_ variables are compiled into the shipped bundle
# — one here is published to every device that installs the app. The code
# refuses `sk_` keys outright; this note is so it never gets that far.
#
# `test_` keys are refused in the production variant only, so purchases can be
# exercised on a real device through a preview/TestFlight build.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog, for product analytics and session replay. The PROJECT API key
# (`phc_…`) is write-only by design — it can send events, never read them — so
# it is safe in the bundle. Never put a personal API key (`phx_…`) here.
# Without it the app simply sends nothing.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
