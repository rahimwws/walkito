{
  "cli": {
    "version": ">= 24.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "uploadSourceMaps": true,
      "ios": {
        "env": {
          "SOURCEMAP_FILE": "build/sourcemaps/main.jsbundle.map"
        },
        "buildArtifactPaths": ["ios/build/sourcemaps/main.jsbundle.map"]
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6813076846"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
